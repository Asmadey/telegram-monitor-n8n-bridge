# Пример окружения. Копируется в .env для локального запуска; в облаке те же
# имена задаются переменными сервиса (Railway) — файл .env туда не едет.
#
# Здесь ТОЛЬКО настройки приложения. Ключи тенантов (OpenRouter, токен бота,
# адрес вебхука, MTProto-сессия) в окружении не живут: они принадлежат
# пользователю, лежат в Postgres зашифрованными и задаются в интерфейсе.
# До Фазы 1 они были здесь — отсюда и путаница, ради которой написан абзац.

# --- Обязательное -----------------------------------------------------------

# Без него приложение не стартует (нет дефолта: молчаливый уход в чужую базу
# однажды уже стоил боевых данных). В Railway — ссылка ${{Postgres.DATABASE_URL}}.
# Формат postgresql:// нормализуется в postgresql+asyncpg:// автоматически.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/teleton

# Fernet-ключ, которым шифруются секреты тенантов: MTProto-сессии, ключи
# интеграций. Генерация: openssl rand -base64 32
# МЕНЯТЬ НЕЛЬЗЯ после первого запуска — смена без перешифровки делает
# нечитаемыми все Telegram-сессии, то есть выбрасывает пользователей из их
# собственных аккаунтов. Ротация — отдельная процедура, а не правка переменной.
APP_ENCRYPTION_KEY=

# Подпись cookie сессий. Генерация: openssl rand -base64 32
# Смена разлогинивает всех — это безопасно, в отличие от строки выше.
SECRET_KEY=

# development | production. В production обязателен RESEND_API_KEY, cookie
# получают флаг Secure, письма уходят по-настоящему.
ENVIRONMENT=development

# --- Telegram MTProto (ключи ПРИЛОЖЕНИЯ, не пользователей) -------------------
# my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Почта (сброс пароля) ----------------------------------------------------
# В development письма пишутся в tmp/mail/ и наружу не уходят.
RESEND_API_KEY=
MAIL_FROM=Teleton <onboarding@resend.dev>
# База для ссылок в письме = адрес ФРОНТЕНДА, а не API.
APP_BASE_URL=http://127.0.0.1:8000

# --- Раздельный деплой (Vercel + Railway) ------------------------------------
# Пусто = фронтенд приходит с того же origin (переписывание /api/* на Vercel),
# cookie остаются первой стороной и CORS не нужен.
FRONTEND_ORIGINS=
# Публичный адрес самого API: по нему определяется, межсайтовый ли запрос.
API_ORIGIN=

# --- Вход через Google (необязательно) ---------------------------------------
# Значения ПУБЛИЧНЫ по устройству Firebase: apiKey идентифицирует проект, а не
# даёт доступ. Приватный ключ сервисного аккаунта не нужен — проверка идёт по
# публичным сертификатам Google. Пусто = кнопка скрыта, CSP не расширяется.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
